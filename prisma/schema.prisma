generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  address       String
  chain         String   @default("sol")
  symbol        String?
  name          String?
  bondingAt    DateTime
  isOnCurve     Boolean
  pumpUrl       String
  twitterUrl    String?
  websiteUrl    String?
  xMentionCount Int?
  jumlah_volume Float?
  rugRatio      Float?
  marketCap     Float?
  athMarketCap  Float?
  tokenCreatedAt DateTime
  rawData       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([bondingAt])
  @@index([xMentionCount])
  @@id([address, chain])
}

model Chat {
  chatId    BigInt   @id
  createdAt DateTime @default(now())
}

model TelegramUser {
  telegramId          BigInt   @id
  username            String?
  walletAddress       String   @unique
  encryptedPrivateKey String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("telegram_users")
}

model Wallet {
  id                  String   @id @default(cuid())
  telegramId          BigInt
  chain               String
  label               String?
  walletAddress       String
  encryptedPrivateKey String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([telegramId, chain])
  @@unique([telegramId, walletAddress])
  @@map("user_wallets")
}

model UserFeedConfig {
  telegramId                  BigInt   @id
  chain                       String   @default("SOLANA")
  activeSolanaWalletId        String?
  activeRobinhoodWalletId     String?
  completedTypes              String   @default("completed")
  completedLimit              Int      @default(80)
  completedMaxBundlerRate     Float    @default(0.2)
  completedMaxBondingAgeHours Float    @default(24)
  completedMaxTokenAgeHours   Float    @default(1)
  completedMinXMentions       Int      @default(1)
  unboundedTypes              String   @default("new_creation,near_completion")
  unboundedLimit              Int      @default(80)
  unboundedMaxBundlerRate     Float    @default(0.2)
  unboundedMaxRugRatio         Float    @default(0.3)
  unboundedMinVolume24h        Float    @default(50000)
  unboundedMaxTokenAgeHours    Float    @default(1)
  unboundedMinXMentions        Int      @default(1)
  earlyTypes                  String   @default("new_creation")
  earlyLimit                  Int      @default(80)
  earlyMinMarketCap            Float    @default(2000)
  earlyMaxMarketCap            Float    @default(3000)
  earlyMinVolume24h            Float    @default(20000)
  earlyMaxTokenAgeMinutes      Float    @default(15)
  earlyMinXMentions            Int      @default(20)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("user_feed_configs")
}

model EarlyToken {
  address        String
  chain          String   @default("sol")
  symbol         String?
  name           String?
  progress       Float
  rugRatio       Float?
  marketCap      Float?
  athMarketCap   Float?
  pumpUrl        String
  twitterUrl     String?
  websiteUrl     String?
  xMentionCount  Int?
  jumlah_volume  Float?
  tokenCreatedAt DateTime
  rawData        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@id([address, chain])
  @@map("early_token")
}

model KonfigTrader {
  telegramId                 BigInt  @id
  solAmountTradePerPosition  Float   @default(0.001)
  ethAmountTradePerPosition  Float   @default(0.001)
  autoTradeFeed              String  @default("EARLY")
  maxTradePositions          Int     @default(1)
  takeProfit1SellPercent     Float   @default(100)
  takeProfit1TargetPercent   Float   @default(200)
  takeProfit2TargetPercent   Float   @default(1000)
  heliusRpcUrl               String  @default("https://mainnet.helius-rpc.com")
  heliusApiKey               String?
  statusAutoTradeBot         Boolean @default(false)
  statusDryRun               Boolean @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("konfig_traders")
}

enum TradePositionStatus {
  OPEN
  CLOSE
}

model TradePosition {
  id                    String              @id @default(cuid())
  chain                 String              @default("sol")
  txHash                String?
  telegramId            BigInt
  amountSol             Float
  amountNative          Float?
  nativeSymbol          String?
  tokenPrice            Float
  tokenSymbol           String?
  tokenAddress          String
  tokenAmount           Float
  tokenDecimals         Int                 @default(6)
  currentPriceSol       Float?
  takeProfit1Sol        Float?
  takeProfit2Sol        Float?
  takeProfit1Executed   Boolean             @default(false)
  takeProfit2Executed   Boolean             @default(false)
  takeProfit1TxHash     String?
  takeProfit2TxHash     String?
  lastPriceAt            DateTime?
  status                TradePositionStatus @default(OPEN)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([telegramId, status])
  @@index([tokenAddress, status])
  @@map("trade_position")
}

model TokenUnboundedFilter {
  address       String
  chain         String   @default("sol")
  symbol        String?
  name          String?
  progress      Float
  rugRatio      Float?
  marketCap     Float?
  athMarketCap  Float?
  pumpUrl       String
  twitterUrl    String?
  websiteUrl    String?
  xMentionCount Int?
  jumlah_volume Float?
  tokenCreatedAt DateTime
  rawData       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@id([address, chain])
  @@map("token_unbounded_filter")
}
